# Copy this file to ".env" (same folder or one folder above the repo) and fill in ONE key.
# The app looks for .env in THIS folder first, then one folder above.
# Never commit your real .env.

# The app accepts any ONE of these keys (checked in this order):

# 1. Course key for gpt-6-luna via Portkey (used by the teaching staff)
PORTKEY_API_KEY=your_portkey_api_key_here

# 2. Your own OpenAI key (you pay for usage)
# OPENAI_API_KEY=your_openai_api_key_here

# 3. Your own Anthropic / Claude key (you pay for usage)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: override the model name for whichever key you use.
# Defaults: Portkey -> gpt-6-luna | OpenAI -> gpt-4o-mini | Anthropic -> claude-opus-5-5
# For the cheapest Claude option, set: LLM_MODEL=claude-haiku-5-5
# LLM_MODEL=
