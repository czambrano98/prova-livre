# Copy this file to ".env" (same folder or one folder above the repo) and fill in your key.
# The app looks for .env in THIS folder first, then one folder above.
# Never commit your real .env.

# Required: course key for gpt-6-luna via Portkey
PORTKEY_API_KEY=your_portkey_api_key_here

# Optional: only if you choose to run your own paid OpenAI model instead
# OPENAI_API_KEY=your_openai_api_key_here
